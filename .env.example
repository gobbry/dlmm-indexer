# docker compose overrides both DB_DSN and API_LISTEN_ADDRESS with its own DSN and ports.
DB_DSN=postgres://postgres:postgres@localhost:5432/dlmm
API_LISTEN_ADDRESS=0.0.0.0:8080

RPC_URL=
# Client-side RPC rate limit budget.
RPC_RPS_MAX=10
# Transaction version handling must stay backward compatible, unless programs explicitly do not
# need the older versions. The value 1 covers legacy, v0 and v1.
TRANSACTION_VERSION_MAX=1

# If empty, the indexer uses the RPC as the live source. We do not recommend this.
GEYSER_URL=
# Empty for providers that authenticate by URL or IP.
GEYSER_X_TOKEN=

BINANCE_DATA_API_URL=https://data-api.binance.vision

# If empty, the RPC provider fills everything.
# If set, docker compose overrides with a compose-compatible value.
ARCHIVE_RPC_URL=http://127.0.0.1:8899
ARCHIVE_RPS_MAX=20

# json (default, one JSON line per event) or pretty.
LOG_FORMAT=json
# tracing-subscriber env filter.
RUST_LOG=info
